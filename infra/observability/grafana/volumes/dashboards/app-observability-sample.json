{
  "uid": "app-observability-sample",
  "title": "app-observability-sample",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["app", "observability"],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 1,
        "query": "label_values(up, job)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 1,
        "query": "label_values(up{job=~\"$service\"}, instance)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Up",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(up{job=~\"$service\", instance=~\"$instance\"})",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": ""},
        "orientation": "horizontal"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Scrape Samples",
      "gridPos": {"x": 6, "y": 0, "w": 18, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(scrape_samples_post_metric_relabeling{job=~\"$service\"}[5m])) by (job)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP Request Rate (if available)",
      "gridPos": {"x": 0, "y": 4, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\"}[5m])) by (job)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Logs",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 10},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "{job=~\"$service\", instance=~\"$instance\"} |= \"\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Log Volume",
      "gridPos": {"x": 0, "y": 18, "w": 24, "h": 6},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum by (job) (rate({job=~\"$service\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "traces",
      "title": "Traces",
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 10},
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [
        {
          "queryType": "traceql",
          "expr": "service.name = \"$service\"",
          "refId": "A"
        }
      ]
    }
  ]
}
